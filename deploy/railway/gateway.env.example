NODE_ENV=production
PORT=4000
HOST=::
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
POLICY_URL=http://${{policy.RAILWAY_PRIVATE_DOMAIN}}:4003
# Same value as POLICY_INTERNAL_TOKEN: gateway forwards it to policy.
GATEWAY_AUTH_TOKEN=REPLACE_WITH_SHARED_POLICY_TOKEN
POLICY_INTERNAL_TOKEN=REPLACE_WITH_SHARED_POLICY_TOKEN
GATEWAY_ALLOW_UNAUTHENTICATED=false
NEXT_PUBLIC_CONSOLE_URL=https://REPLACE_CONSOLE.vercel.app
NEXT_PUBLIC_LANDING_URL=https://REPLACE_LANDING.vercel.app
CORS_ORIGIN=
