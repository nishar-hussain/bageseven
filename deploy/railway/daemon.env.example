# Railway service: daemon. Replace placeholders in Railway Variables.
NODE_ENV=production
PROVIDER_SCOPE_SIGNING_KEY=REPLACE_WITH_SHARED_SCOPE_SIGNING_SECRET
PORT=4001
HOST=::
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
POLICY_URL=http://${{policy.RAILWAY_PRIVATE_DOMAIN}}:4003
AUTH_SECRET=REPLACE_WITH_SHARED_RANDOM_SECRET
DAEMON_AUTH_TOKEN=REPLACE_WITH_SHARED_DAEMON_TOKEN
POLICY_INTERNAL_TOKEN=REPLACE_WITH_SHARED_POLICY_TOKEN
PROVIDER_FUNDED_GAS=true
PROVIDER_GAS_ENCRYPTION_KEY=REPLACE_WITH_SHARED_32_BYTE_HEX_KEY
RESEND_API_KEY=REPLACE_WITH_RESEND_KEY
RESEND_FROM="Bagseven <bags@cesthq.com>"
OPERATOR_NOTIFY_EMAIL=bags@cesthq.com
NEXT_PUBLIC_CONSOLE_URL=https://REPLACE_CONSOLE.vercel.app
NEXT_PUBLIC_LANDING_URL=https://REPLACE_LANDING.vercel.app
CORS_ORIGIN=
# Mount a Railway volume at /data; custom feature registry is stored here.
BAGSEVEN_DATA_DIR=/data
BAGSEVEN_REQUIRE_GRANT=true
BAGSEVEN_GRANT_FEATURE=ocr
# Bind dashboard purchases to the same default worker used by MCP.
BAGSEVEN_MCP_WORKER=REPLACE_WITH_WORKER_UUID
# Optional shared daemon/MCP container. Set true and PORT=4009 together.
BAGSEVEN_MCP_EMBEDDED=false
BAGSEVEN_MCP_PUBLIC_URL=https://REPLACE_MCP.up.railway.app
MCP_OAUTH_REQUIRED=true
MCP_OAUTH_CLIENT_ID=bagseven-chatgpt
DEV_MODE=false
SIGNER_MODE=live
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
RPC_FALLBACK_URL=
CHAIN_ID=43113
USDC_ADDRESS=REPLACE_MANDATE_TOKEN_ADDRESS
DAEMON_OPERATOR_KEY=REPLACE_OPERATOR_PRIVATE_KEY
# Separate encryption key for provider-approved isolated payment signers; daemon only.
X402_PAYMENT_ENCRYPTION_KEY=REPLACE_X402_PAYMENT_ENCRYPTION_KEY
X402_FACILITATOR_URL=https://facilitator.payai.network
# Optional dedicated settlement signer for legacy mint/credit utilities.
ENTITLEMENT_STORE=avalanche
BAGSEVEN_PUBLISHABLE_KEY=REPLACE_PUBLISHABLE_KEY
BAGSEVEN_SECRET_KEY=REPLACE_SECRET_KEY

# Avalanche C-Chain (Fuji)
AVALANCHE_NETWORK=fuji
AVALANCHE_CHAIN_ID=43113
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_USDC=
AVALANCHE_ENTITLEMENT_REGISTRY=
ENTITLEMENT_SUBJECT_SECRET=
AVALANCHE_CONFIRMATIONS=2
AVALANCHE_DEMO_SETTLE=false
