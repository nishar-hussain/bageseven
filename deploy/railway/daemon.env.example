# Railway service: daemon. Replace placeholders in Railway Variables.
NODE_ENV=production
PORT=4001
HOST=::
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
POLICY_URL=http://${{policy.RAILWAY_PRIVATE_DOMAIN}}:4003
AUTH_SECRET=REPLACE_WITH_SHARED_RANDOM_SECRET
DAEMON_AUTH_TOKEN=REPLACE_WITH_SHARED_DAEMON_TOKEN
POLICY_INTERNAL_TOKEN=REPLACE_WITH_SHARED_POLICY_TOKEN
RESEND_API_KEY=REPLACE_WITH_RESEND_KEY
RESEND_FROM="Bagseven <bags@cesthq.com>"
OPERATOR_NOTIFY_EMAIL=bags@cesthq.com
NEXT_PUBLIC_CONSOLE_URL=https://REPLACE_CONSOLE.vercel.app
NEXT_PUBLIC_LANDING_URL=https://REPLACE_LANDING.vercel.app
CORS_ORIGIN=
# Mount a Railway volume at /data; custom feature registry is stored here.
BAGSEVEN_DATA_DIR=/data
BAGSEVEN_REQUIRE_GRANT=true
BAGSEVEN_GRANT_FEATURE=ocr
DEV_MODE=false
SIGNER_MODE=live
# World: use IDKit RP credentials for human login/mint.
WORLD_MOCK_PROOFS=false
WORLD_APP_ID=REPLACE_WORLD_APP_ID
WORLD_RP_ID=REPLACE_WORLD_RP_ID
WORLD_RP_SIGNING_KEY=REPLACE_WORLD_RP_SIGNING_KEY
WORLD_SIGNER_ADDRESS=REPLACE_WORLD_SIGNER_ADDRESS
WORLD_IDKIT_ACTION=bagseven-mint
WORLD_IDKIT_LOGIN_ACTION=bagseven-login
WORLD_IDKIT_LOGIN_SIGNAL=bagseven-login
WORLD_IDKIT_ENVIRONMENT=production
WORLD_AGENT_PASS_ENABLED=true
WORLD_CLIENT_ID=REPLACE_AGENT_PASS_CLIENT_ID
WORLD_CLIENT_SECRET=REPLACE_AGENT_PASS_CLIENT_SECRET
WORLD_TOKEN_AUTH_METHOD=client_secret_basic
WORLD_REDIRECT_URI=https://REPLACE_CONSOLE.vercel.app/app/mint
# Whitechain: testnet is live onchain, not the local Anvil fixture.
WHITECHAIN_DEMO_SETTLE=false
WHITECHAIN_NETWORK=testnet
WHITECHAIN_CHAIN_ID=1874
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
WHITECHAIN_USDT=0xaa7962d073935D387e8d442DA1D7149C81388f46
WHITECHAIN_CONFIRMATIONS=2
RPC_URL=https://rpc.testnet.whitechain.io
RPC_FALLBACK_URL=
CHAIN_ID=1874
USDC_ADDRESS=REPLACE_MANDATE_TOKEN_ADDRESS
DAEMON_OPERATOR_KEY=REPLACE_OPERATOR_PRIVATE_KEY
DAEMON_EXECUTOR_KEY=REPLACE_EXECUTOR_PRIVATE_KEY
DAEMON_EXECUTOR_ADDRESS=REPLACE_EXECUTOR_ADDRESS
# Optional dedicated x402 payer; must differ from operator/enforcer keys.
BAGSEVEN_X402_PAYER_KEY=
# Optional dedicated settlement signer for legacy mint/credit utilities.
WHITECHAIN_PRIVATE_KEY=
WHITECHAIN_PAY_TO=
# Arkiv: persistent grants. Missing keys fail closed.
ENTITLEMENT_STORE=arkiv
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
ARKIV_ACCESS_KEY=REPLACE_ARKIV_ACCESS_KEY
ARKIV_PRIVATE_KEY=REPLACE_ARKIV_PRIVATE_KEY
BAGSEVEN_PUBLISHABLE_KEY=REPLACE_PUBLISHABLE_KEY
BAGSEVEN_SECRET_KEY=REPLACE_SECRET_KEY
