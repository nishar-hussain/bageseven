NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
PROVIDER_SCOPE_SIGNING_KEY=REPLACE_WITH_SHARED_SCOPE_SIGNING_SECRET
RESEND_API_KEY=REPLACE_WITH_RESEND_KEY
RESEND_FROM="Bagseven <bags@cesthq.com>"
PORT=4009
HOST=::
DAEMON_URL=http://${{daemon.RAILWAY_PRIVATE_DOMAIN}}:4001
DAEMON_AUTH_TOKEN=REPLACE_WITH_SHARED_DAEMON_TOKEN
# One stable UUID, shared with Vercel console. New payments require a registered agent;
# prepaid credits remain usable through entitlement-only connections.
BAGSEVEN_MCP_WORKER=REPLACE_WITH_WORKER_UUID
BAGSEVEN_MCP_PUBLIC_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
MCP_OAUTH_REQUIRED=true
MCP_OAUTH_CLIENT_ID=bagseven-chatgpt
NEXT_PUBLIC_CONSOLE_URL=https://REPLACE_CONSOLE.vercel.app
NEXT_PUBLIC_LANDING_URL=https://REPLACE_LANDING.vercel.app
CORS_ORIGIN=

# Avalanche C-Chain (Fuji)
AVALANCHE_NETWORK=fuji
AVALANCHE_CHAIN_ID=43113
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_USDC=
AVALANCHE_ENTITLEMENT_REGISTRY=
ENTITLEMENT_SUBJECT_SECRET=
AVALANCHE_CONFIRMATIONS=2
AVALANCHE_DEMO_SETTLE=false
