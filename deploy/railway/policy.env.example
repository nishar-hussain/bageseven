NODE_ENV=production
PROVIDER_SCOPE_SIGNING_KEY=REPLACE_WITH_SHARED_SCOPE_SIGNING_SECRET
PORT=4003
HOST=::
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
POLICY_INTERNAL_TOKEN=REPLACE_WITH_SHARED_POLICY_TOKEN
PROVIDER_ADMIN_TOKEN=REPLACE_PROVIDER_ADMIN_TOKEN
PROVIDER_FUNDED_GAS=true
PROVIDER_GAS_ENCRYPTION_KEY=REPLACE_WITH_SHARED_32_BYTE_HEX_KEY
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
RPC_FALLBACK_URL=
CHAIN_ID=43113
DAEMON_OPERATOR_KEY=REPLACE_OPERATOR_PRIVATE_KEY
# Optional separate account for deployment gas; defaults to executor when blank.
MANDATE_DEPLOYER_KEY=

# Avalanche C-Chain (Fuji)
AVALANCHE_NETWORK=fuji
AVALANCHE_CHAIN_ID=43113
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_USDC=
AVALANCHE_ENTITLEMENT_REGISTRY=
ENTITLEMENT_SUBJECT_SECRET=
AVALANCHE_CONFIRMATIONS=2
AVALANCHE_DEMO_SETTLE=false
