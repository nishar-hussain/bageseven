FROM node:24-bookworm-slim
WORKDIR /app
RUN npm install --global pnpm@10.33.0
COPY . .
RUN pnpm install --frozen-lockfile --prod=false
RUN pnpm exec turbo run build --filter=@bagseven/daemon... --filter=@bagseven/gateway... --filter=@bagseven/policy...
ENV NODE_ENV=production
ENV HOST=::
CMD ["node", "services/daemon/dist/index.js"]
