# Bagseven — copy to .env (`pnpm setup` fills local keys)

DATABASE_URL=postgres://bagseven:bagseven@localhost:55432/bagseven
REDIS_PORT=56379
REDIS_URL=redis://localhost:56379

GATEWAY_PORT=4000
DAEMON_PORT=4001
POLICY_PORT=4003
BAGSEVEN_MCP_PORT=4009

DAEMON_URL=http://localhost:4001
POLICY_URL=http://localhost:4003
GATEWAY_URL=http://localhost:4000
# HTTPS *.vercel.app and *.railway.app origins are allowed automatically.
# Add comma-separated custom origins here; production localhost is denied by default.
CORS_ORIGIN=
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3000
NEXT_PUBLIC_LANDING_URL=http://localhost:3001
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_DAEMON_URL=http://localhost:4001

DEV_MODE=true
SIGNER_MODE=dev
# Local Anvil impersonates Whitechain Testnet (1874); no real funds.
RPC_URL=http://localhost:58545
CHAIN_ID=1874
USDC_ADDRESS=
LOCAL_MANDATE_ID=

# Operator auth (dashboard magic link) + Resend
AUTH_SECRET=
# Empty = any email can sign in. Comma-list to lock to invites only.
AUTH_ALLOWLIST=
OPERATOR_NOTIFY_EMAIL=bags@cesthq.com
RESEND_API_KEY=
# Set to log for local checks without sending emails (preserves the API key).
NOTIFY_MODE=
RESEND_FROM="Bagseven <bags@cesthq.com>"

# Daemon / MCP
DAEMON_OPERATOR_KEY=
DAEMON_EXECUTOR_KEY=
DAEMON_EXECUTOR_ADDRESS=
DAEMON_OWNER_KEY=
# Public owner shown by default on Agent spending; set to the owner of your MCP agent.
# This does not rebind the MCP worker or change any private key.
DAEMON_OWNER_ADDRESS=
# Optional separate account paying WBT gas for permission deployment.
# Falls back to DAEMON_EXECUTOR_KEY when blank; never exposed to the browser.
MANDATE_DEPLOYER_KEY=
DAEMON_AUTH_TOKEN=
BAGSEVEN_SECRET_KEY=
BAGSEVEN_PUBLISHABLE_KEY=
NEXT_PUBLIC_BAGSEVEN_PUBLISHABLE_KEY=
NEXT_PUBLIC_BAGSEVEN_API_URL=http://localhost:3000/api/public
MCP_AUTH_TOKEN=
# Public HTTPS base for ChatGPT custom MCP (ngrok / tunnel). Enables OAuth AS.
BAGSEVEN_MCP_PUBLIC_URL=
MCP_OAUTH_REQUIRED=true
MCP_OAUTH_CLIENT_ID=bagseven-chatgpt
MCP_OAUTH_CLIENT_SECRET=
POLICY_INTERNAL_TOKEN=
# Gateway requires this Bearer (falls back to POLICY_INTERNAL_TOKEN). Never expose publicly.
GATEWAY_AUTH_TOKEN=
# Break-glass only (forbidden in production): skip gateway Bearer checks.
GATEWAY_ALLOW_UNAUTHENTICATED=false
PROVIDER_ADMIN_TOKEN=
BAGSEVEN_MCP_WORKER=
BAGSEVEN_PROVIDER_KEYS={}
BAGSEVEN_REQUIRE_PROVIDER_ALLOWLIST=false
BAGSEVEN_ALLOWED_PROVIDER_HOSTS=

# Dual-gate
BAGSEVEN_REQUIRE_GRANT=true
BAGSEVEN_GRANT_FEATURE=ocr

# Arkiv (memory unless both keys set)
ENTITLEMENT_STORE=memory
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_ACCESS_KEY=
ARKIV_PRIVATE_KEY=
ARKIV_CHAIN_ID=7794095

# World ID — two first-class products (do not reuse credentials across them)
# 1) IDKit uniqueness: Developer Portal app_id + rp_id + signing_key
# 2) Agent Pass OIDC: auth.world.org/portal client_id + worldidp_client_secret_…
WORLD_AGENT_PASS_ENABLED=true
WORLD_MOCK_PROOFS=false
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
# Public signer registered for this RP; the server checks that the key matches it.
WORLD_SIGNER_ADDRESS=
WORLD_IDKIT_ACTION=bagseven-mint
# Must differ from mint — uniqueness nullifiers are one-shot per action (nullifier_replayed on reuse).
WORLD_IDKIT_LOGIN_ACTION=bagseven-login
WORLD_IDKIT_LOGIN_SIGNAL=bagseven-login
WORLD_IDKIT_ENVIRONMENT=production
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_RP_ID=
NEXT_PUBLIC_WORLD_IDKIT_ACTION=bagseven-mint
NEXT_PUBLIC_WORLD_IDKIT_ENVIRONMENT=production
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
WORLD_TOKEN_AUTH_METHOD=client_secret_basic
WORLD_REDIRECT_URI=http://127.0.0.1:3000/app/mint

# Whitechain Testnet (money clock)
WHITECHAIN_NETWORK=testnet
WHITECHAIN_CHAIN_ID=1874
WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
# Optional recipient for legacy direct mint/credit utilities only.
# B2B checkout pays each plan merchant_wallet; leave blank for provider checkout.
WHITECHAIN_PAY_TO=
# Optional, dedicated operator-funded settlement key. Browser checkout uses the buyer's wallet.
WHITECHAIN_PRIVATE_KEY=
WHITECHAIN_USDT=0xaa7962d073935D387e8d442DA1D7149C81388f46
NEXT_PUBLIC_WHITECHAIN_USDT=0xaa7962d073935D387e8d442DA1D7149C81388f46
NEXT_PUBLIC_WHITECHAIN_CHAIN_ID=1874
NEXT_PUBLIC_REOWN_PROJECT_ID=
WHITECHAIN_CONFIRMATIONS=2
# Explicit local test fixture only; never accepted in production.
WHITECHAIN_DEMO_SETTLE=false

# RainbowKit / WalletConnect Cloud project id (https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_WHITECHAIN_RPC_URL=https://rpc.testnet.whitechain.io
NEXT_PUBLIC_WHITECHAIN_EXPLORER=https://explorer.testnet.whitechain.io

