# Bagseven — public Fuji runtime. Use fuji:prepare / fuji:activate; never paste wallet keys here.

DATABASE_URL=postgres://bagseven:bagseven@localhost:55432/bagseven_fuji
CONSOLE_DATABASE_URL=
PROVIDER_SCOPE_SIGNING_KEY=
REDIS_PORT=56379
REDIS_URL=redis://localhost:56379

GATEWAY_PORT=4000
DAEMON_PORT=4001
POLICY_PORT=4003
BAGSEVEN_MCP_PORT=4009

DAEMON_URL=http://localhost:4001
POLICY_URL=http://localhost:4003
GATEWAY_URL=http://localhost:4000
# HTTPS *.vercel.app and *.railway.app origins are allowed automatically.
# Add comma-separated custom origins here; production localhost is denied by default.
CORS_ORIGIN=
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3000
# Existing console origin for invoice links and MCP session-based consent. Use HTTPS when hosted.
CONSOLE_URL=http://localhost:3000
NEXT_PUBLIC_LANDING_URL=http://localhost:3001
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
NEXT_PUBLIC_DAEMON_URL=http://localhost:4001

DEV_MODE=false
SIGNER_MODE=live
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=43113
USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65

# Account auth (email OTP + wallet ownership; legacy magic links supported) + Resend
AUTH_SECRET=
# Empty = any email can sign in. Comma-list to lock to invites only.
AUTH_ALLOWLIST=
OPERATOR_NOTIFY_EMAIL=bags@cesthq.com
RESEND_API_KEY=
# Set to log for local checks without sending emails (preserves the API key).
NOTIFY_MODE=
RESEND_FROM="Bagseven <bags@cesthq.com>"

# Daemon / MCP
DAEMON_OPERATOR_KEY=
# Public owner shown by default on Agent spending; set to the owner of your MCP agent.
# This does not rebind the MCP worker or change any private key.
DAEMON_OWNER_ADDRESS=
# Provider-funded mode is the default. Legacy platform signers are not used for fees.
PROVIDER_FUNDED_GAS=true
# 32-byte hex AES encryption key for delegated provider accounts. Keep backed up.
PROVIDER_GAS_ENCRYPTION_KEY=
# Internal service credential. Never return this to a dashboard or SDK customer.
DAEMON_AUTH_TOKEN=
# Deployment signing/legacy operator credential; providers create their own keys in Developers.
BAGSEVEN_SECRET_KEY=
# Legacy catalog key for operator/local integrations. Customer data requires scoped authentication.
BAGSEVEN_PUBLISHABLE_KEY=
NEXT_PUBLIC_BAGSEVEN_PUBLISHABLE_KEY=
NEXT_PUBLIC_BAGSEVEN_API_URL=http://localhost:3000/api/public
# Public HTTPS base for ChatGPT custom MCP (ngrok / tunnel). Enables OAuth AS.
BAGSEVEN_MCP_PUBLIC_URL=
MCP_OAUTH_REQUIRED=true
MCP_OAUTH_CLIENT_ID=bagseven-chatgpt
MCP_OAUTH_CLIENT_SECRET=
POLICY_INTERNAL_TOKEN=
# Gateway requires this Bearer (falls back to POLICY_INTERNAL_TOKEN). Never expose publicly.
GATEWAY_AUTH_TOKEN=
# Break-glass only (forbidden in production): skip gateway Bearer checks.
GATEWAY_ALLOW_UNAUTHENTICATED=false
PROVIDER_ADMIN_TOKEN=
BAGSEVEN_MCP_WORKER=
BAGSEVEN_REQUIRE_PROVIDER_ALLOWLIST=false
BAGSEVEN_ALLOWED_PROVIDER_HOSTS=

# Dual-gate
BAGSEVEN_REQUIRE_GRANT=true
BAGSEVEN_GRANT_FEATURE=ocr

ENTITLEMENT_STORE=avalanche


# Optional recipient for legacy direct mint/credit utilities only.
# B2B checkout pays each plan merchant_wallet; leave blank for provider checkout.
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Explicit local test fixture only; never accepted in production.

# RainbowKit / WalletConnect Cloud project id (https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=


# Avalanche C-Chain (Fuji)
AVALANCHE_NETWORK=fuji
AVALANCHE_CHAIN_ID=43113
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_USDC=0x5425890298aed601595a70AB815c96711a31Bc65
AVALANCHE_ENTITLEMENT_REGISTRY=
ENTITLEMENT_SUBJECT_SECRET=
AVALANCHE_CONFIRMATIONS=2
AVALANCHE_DEMO_SETTLE=false

# Optional receipt scanner integration. Use a real verified provider account;
# keep provider scope and API secrets server-side. Run with pnpm demo:dapp.
DEMO_PROVIDER_ID=
DEMO_HOLDER=
# Verified customer contact from the merchant backend, kept off-chain.
DEMO_CUSTOMER_EMAIL=

NEXT_PUBLIC_AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_AVALANCHE_EXPLORER=https://testnet.snowtrace.io

# Separate from gas custody. Preserve this key for delegated payment recovery.
X402_PAYMENT_ENCRYPTION_KEY=
X402_FACILITATOR_URL=https://facilitator.payai.network
