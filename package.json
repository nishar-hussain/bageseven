{
  "name": "bagseven",
  "version": "0.1.0",
  "private": true,
    "description": "Bagseven — Avalanche paid access, recurring billing, agent mandates, SDK and MCP",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "setup": "node scripts/setup-platform.mjs",
    "setup:platform": "node scripts/setup-platform.mjs",
    "setup:prod": "node scripts/setup-prod.mjs",
    "check:prod": "node scripts/check-production.mjs",
    "check:railway": "node --import tsx .railway/check.mjs",
    "check:hosted": "node --env-file=.env.prod scripts/check-hosted-backend.mjs",
    "test:railway-image": "node .railway/smoke.mjs",
    "dev": "node scripts/start-local.mjs",
    "start:local": "node scripts/start-local.mjs",
    "mcp:local": "node scripts/mcp-local.mjs",
    "mcp:tunnel": "node scripts/mcp-tunnel.mjs",
    "fuji:registry": "node scripts/fuji-registry.mjs",
    "fuji:prepare": "node scripts/prepare-fuji.mjs",
    "upgrade:local-x402": "node scripts/upgrade-local-x402.mjs",
    "test:x402": "node --env-file-if-exists=.env --import tsx scripts/test-x402-local.mjs",
    "bagseven-mcp": "tsx scripts/bagseven-mcp.ts",
    "avalanche:settle": "tsx scripts/avalanche-demo-settle.ts",
    "sdk:demo": "node --env-file-if-exists=.env scripts/sdk-demo.mjs",
    "demo:dapp": "pnpm --filter @bagseven/demo-dapp dev",
    "demo:check": "pnpm --filter @bagseven/demo-dapp check",
    "smoke": "node scripts/smoke-mumbai.mjs",
    "smoke:e2e": "node scripts/test-avalanche-checkout.mjs",
    "smoke:mcp": "node --env-file-if-exists=.env --import tsx scripts/mcp-smoke.ts",
    "seed:local": "node --env-file-if-exists=.env scripts/seed-local.mjs",
    "test:mandate": "node --env-file-if-exists=.env scripts/test-mandate-flow.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node scripts/test-platform.mjs",
    "db:up": "docker compose -f deploy/docker-compose.yml up -d",
    "db:down": "docker compose -f deploy/docker-compose.yml down",
    "db:migrate": "pnpm --filter @bagseven/db run migrate",
    "db:generate": "pnpm --filter @bagseven/db run generate",
    "pm2:start": "pnpm exec pm2 start deploy/ecosystem.config.cjs",
    "pm2:stop": "pnpm exec pm2 stop deploy/ecosystem.config.cjs",
    "pm2:status": "pnpm exec pm2 status",
    "pm2:logs": "pnpm exec pm2 logs",
    "pm2:restart": "pnpm exec pm2 restart deploy/ecosystem.config.cjs",
    "integrations:check": "node scripts/check-live-integrations.mjs",
    "test:checkout": "node scripts/test-avalanche-checkout.mjs",
    "start": "node scripts/start-local.mjs",
    "stop:local": "node scripts/start-local.mjs --stop",
    "status:local": "node scripts/start-local.mjs --status"
  },
  "devDependencies": {
    "@bagseven/db": "workspace:*",
    "@bagseven/entitlements": "workspace:*",
    "@bagseven/onchain": "workspace:*",
    "@bagseven/server": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.1",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "express": "^5.1.0",
    "pm2": "^7.0.4",
    "qrcode": "1.5.4",
    "railway": "3.16.0",
    "solc": "^0.8.37",
    "tsx": "^4.23.13",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "viem": "^2.56.8",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
