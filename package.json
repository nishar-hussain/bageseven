{
  "name": "bagseven",
  "version": "0.1.0",
  "private": true,
  "description": "Bagseven — mandates, living entitlements, Whitechain settlement, World mint, SDK + MCP",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup-platform.mjs",
    "setup:platform": "node scripts/setup-platform.mjs",
    "dev": "node scripts/start-local.mjs",
    "start:local": "node scripts/start-local.mjs",
    "mcp:local": "node scripts/mcp-local.mjs",
    "bagseven-mcp": "tsx scripts/bagseven-mcp.ts",
    "whitechain:settle": "tsx scripts/whitechain-demo-settle.ts",
    "sdk:demo": "node --env-file-if-exists=.env scripts/sdk-demo.mjs",
    "smoke": "node scripts/smoke-mumbai.mjs",
    "smoke:e2e": "node scripts/smoke-e2e.mjs",
    "smoke:mcp": "node --env-file-if-exists=.env --import tsx scripts/mcp-smoke.ts",
    "seed:local": "node --env-file-if-exists=.env scripts/seed-local.mjs",
    "test:mandate": "node --env-file-if-exists=.env scripts/test-mandate-flow.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose -f deploy/docker-compose.yml up -d",
    "db:down": "docker compose -f deploy/docker-compose.yml down",
    "db:migrate": "pnpm --filter @bagseven/db run migrate",
    "db:generate": "pnpm --filter @bagseven/db run generate",
    "pm2:start": "pnpm exec pm2 start deploy/ecosystem.config.cjs",
    "pm2:stop": "pnpm exec pm2 stop deploy/ecosystem.config.cjs",
    "pm2:status": "pnpm exec pm2 status",
    "pm2:logs": "pnpm exec pm2 logs",
    "pm2:restart": "pnpm exec pm2 restart deploy/ecosystem.config.cjs"
  },
  "devDependencies": {
    "@bagseven/db": "workspace:*",
    "@bagseven/entitlements": "workspace:*",
    "@bagseven/money": "workspace:*",
    "@bagseven/onchain": "workspace:*",
    "@bagseven/server": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "express": "^5.1.0",
    "pm2": "^7.0.4",
    "solc": "^0.8.37",
    "tsx": "^4.23.13",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "viem": "^2.56.8",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
